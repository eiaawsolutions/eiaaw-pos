{
  "name": "eiaaw-pos",
  "private": true,
  "version": "0.1.0",
  "description": "EIAAW Solutions AI-native POS platform",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build -w packages/shared && npm run build -w apps/api && npm run build -w apps/worker && npm run build -w apps/web",
    "build:api": "npm run build -w packages/shared && npm run build -w apps/api",
    "build:web": "npm run build -w packages/shared && npm run build -w apps/web",
    "build:worker": "npm run build -w packages/shared && npm run build -w apps/worker",
    "dev:api": "npm run dev -w apps/api",
    "dev:web": "npm run dev -w apps/web",
    "dev:worker": "npm run dev -w apps/worker",
    "db:migrate": "npm run db:migrate -w apps/api",
    "db:seed": "npm run db:seed -w apps/api",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:shared": "vitest run --project shared",
    "test:api": "vitest run --project api",
    "typecheck": "npm run typecheck -w packages/shared && npm run typecheck -w apps/api && npm run typecheck -w apps/worker && npm run typecheck -w apps/web",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "postinstall": "prisma generate --schema apps/api/prisma/schema.prisma"
  },
  "overrides": {
    "postcss": "^8.5.25",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@eslint/js": "^9.39.5",
    "@nestjs/testing": "^11.1.28",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "lefthook": "^1.13.6",
    "prettier": "^3.9.6",
    "supertest": "^7.2.2",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  }
}
