// EIAAW POS — core data model (PostgreSQL)
// Money is stored as integer sen. No PAN is ever stored (PCI SAQ-A posture).

// `queryCompiler` was in previewFeatures and made every query throw on Node 24:
// the WASM compiler's panic registry is never initialised, so it dies in its own
// error handler ("Cannot read properties of undefined (reading 'set_message')")
// and masks the real error underneath. `driverAdapters` alone keeps the PrismaPg
// adapter the services already use. Revisit when moving to Prisma 7, where the
// query compiler is no longer a preview flag.
generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Org & access ──────────────────────────────────────────────────────────────

model Outlet {
  id        String   @id @default(cuid())
  name      String
  profile   String   @default("RETAIL") // RETAIL | FNB | EVENTS | SERVICES
  address   String?
  sstNo     String?
  tin       String? // LHDN taxpayer identification (MyInvois)
  // IANA zone. The trading day is the outlet's, not the server's: on a UTC
  // host a naive local date rolls the Malaysian day over at 08:00, mid-rush.
  timezone  String   @default("Asia/Kuala_Lumpur")
  createdAt DateTime @default(now())

  registers Register[]
  inventory InventoryLevel[]
  orders    Order[]
  shifts    Shift[]
  sequences OrderSequence[]
  staff     User[]
}

// One row per outlet per trading day, incremented atomically to allocate the
// next receipt number. A `COUNT(*) + 1` cannot do this: two terminals reading
// the same count both build the same number and one loses the unique index —
// a failed sale at the counter, at exactly the busiest moment.
//
// Allocation happens inside the order transaction, so a rolled-back order
// returns its number rather than leaving a gap. Gaps in a receipt sequence are
// a question an auditor gets to ask; the cost is that concurrent orders for one
// outlet serialise on this row for the length of the transaction.
model OrderSequence {
  id           String @id @default(cuid())
  outletId     String
  outlet       Outlet @relation(fields: [outletId], references: [id])
  businessDate String // YYYY-MM-DD in the outlet's timezone
  lastValue    Int    @default(0)

  @@unique([outletId, businessDate])
}

model Register {
  id        String    @id @default(cuid())
  name      String
  outletId  String
  outlet    Outlet    @relation(fields: [outletId], references: [id])
  deviceKey String    @unique @default(cuid()) // device registration token
  lastSeen  DateTime?
  eventMode Boolean   @default(false)

  orders Order[]
  shifts Shift[]
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  pin          String? // hashed 6-digit PIN for terminal switch-user
  passwordHash String
  role         String   @default("CASHIER") // OWNER | MANAGER | CASHIER | KITCHEN
  active       Boolean  @default(true)
  // The outlet this user works at. Null means unrestricted — an owner or a
  // roaming manager. Anyone pinned to an outlet cannot read or move stock,
  // takings or reports belonging to another: every outlet-scoped endpoint used
  // to take the outlet id straight from the query string and trust it.
  outletId     String?
  outlet       Outlet?  @relation(fields: [outletId], references: [id])
  createdAt    DateTime @default(now())

  orders            Order[]        @relation("OrderStaff")
  approvedDiscounts Order[]        @relation("OrderDiscountApprover")
  shifts            Shift[]
  auditLogs         AuditLog[]
  cashMovements     CashMovement[]
}

// ── Discount authority ────────────────────────────────────────────────────────

// What each role may take off a sale unaided. Anything beyond it needs someone
// with more authority to approve at the terminal, which is the difference
// between a discount that is merely recorded and one that was actually allowed.
//
// Configurable per deployment because the answer is a commercial decision, not
// an engineering one: a market stall and a franchise chain draw this line in
// very different places.
model DiscountPolicy {
  role          String   @id // OWNER | MANAGER | CASHIER | KITCHEN
  // Ceiling on any single line's discount against that line, and on the
  // cart's total discount against its subtotal. 1000 is 10%.
  maxPercentBps Int      @default(0)
  // Absolute ceiling in sen on the whole sale's discount. Null is no ceiling —
  // a percentage alone stops meaning much on a RM10,000 basket.
  maxAmountSen  Int?
  updatedAt     DateTime @updatedAt
}

// Every sign-in attempt, successful or not. /auth/login and /auth/pin are the
// only unauthenticated doors into the system and had no counter on either, so a
// password or a six-digit PIN was however many requests an attacker cared to
// send.
//
// In the database rather than in process memory because this runs behind
// replicas: an in-memory counter is per-instance, and an attacker spreading
// attempts across them multiplies their allowance by the replica count.
model LoginAttempt {
  id         String   @id @default(cuid())
  kind       String // PASSWORD | PIN
  // Lowercased email for a password attempt; null for a PIN, which identifies
  // nobody until it matches. Never the credential itself.
  identifier String?
  ip         String?
  success    Boolean
  createdAt  DateTime @default(now())

  @@index([kind, identifier, createdAt])
  @@index([kind, ip, createdAt])
}

// Webhook deliveries already applied, so a captured payload cannot be replayed.
// A PSP retries on any non-2xx and the network retries under it, so redelivery
// is ordinary traffic — the difference between a retry and an attack is only
// who sent it.
model WebhookEvent {
  id          String   @id @default(cuid())
  provider    String
  eventId     String
  providerRef String?
  receivedAt  DateTime @default(now())

  @@unique([provider, eventId])
}

// Every approval attempt, successful or not, so a PIN cannot be ground down
// one guess at a time. Six digits is a small space, and the terminal is on the
// shop floor.
model ApprovalAttempt {
  id         String   @id @default(cuid())
  action     String // DISCOUNT
  registerId String?
  approverId String? // only on success — a failure has no identified user
  success    Boolean
  createdAt  DateTime @default(now())

  @@index([registerId, createdAt])
}

// ── Catalog ───────────────────────────────────────────────────────────────────

model Category {
  id       String    @id @default(cuid())
  name     String
  sort     Int       @default(0)
  color    String? // POS grid tile color
  products Product[]
}

model Product {
  id          String    @id @default(cuid())
  name        String
  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id])
  description String?
  imageUrl    String?
  // A foreign key rather than free text: a typo here used to be discoverable
  // only at the till, as a refused sale, on whichever item nobody had sold yet.
  taxCode     String    @default("SST8")
  tax         TaxCode   @relation(fields: [taxCode], references: [code])
  isComposite Boolean   @default(false)
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())

  variants Variant[]
}

// ── Tax ───────────────────────────────────────────────────────────────────────

model TaxCode {
  code   String  @id // SST8 | SST6 | ZRL | EXEMPT | ...
  name   String // shown in the back office and on the rate history
  active Boolean @default(true)

  rates    TaxRate[]
  products Product[]
}

// Rates are append-only and effective-dated, never edited in place.
//
// A rate change arrives on a gazetted date — Malaysian service tax went from 6%
// to 8% on 1 March 2024 — so the system has to know both the old rate and the
// new one, and which applied when. Editing a row instead would silently restate
// what every historical order was charged, and those orders are what the
// merchant filed their SST return against.
model TaxRate {
  id            String   @id @default(cuid())
  code          String
  taxCode       TaxCode  @relation(fields: [code], references: [code])
  // Basis points: 800 is 8%. An integer, so extracting tax from a
  // tax-inclusive price stays exact integer arithmetic end to end.
  rateBps       Int
  effectiveFrom DateTime
  note          String? // e.g. the gazette or budget announcement it came from
  createdAt     DateTime @default(now())
  createdById   String?

  @@unique([code, effectiveFrom])
  @@index([code, effectiveFrom])
}

model Variant {
  id         String  @id @default(cuid())
  productId  String
  product    Product @relation(fields: [productId], references: [id])
  sku        String  @unique
  name       String // e.g. "Red / L" or same as product for single-variant
  price      Int // sen
  cost       Int     @default(0) // sen, moving average
  trackStock Boolean @default(true)
  active     Boolean @default(true)

  barcodes   Barcode[]
  inventory  InventoryLevel[]
  orderLines OrderLine[]
  movements  StockMovement[]
}

model Barcode {
  id        String  @id @default(cuid())
  code      String  @unique // GTIN/EAN/UPC or internal
  variantId String
  variant   Variant @relation(fields: [variantId], references: [id])
}

// ── Inventory ────────────────────────────────────────────────────────────────

model InventoryLevel {
  id        String  @id @default(cuid())
  outletId  String
  outlet    Outlet  @relation(fields: [outletId], references: [id])
  variantId String
  variant   Variant @relation(fields: [variantId], references: [id])
  onHand    Int     @default(0)
  reorderAt Int     @default(0)

  @@unique([outletId, variantId])
}

model StockMovement {
  id        String   @id @default(cuid())
  outletId  String
  variantId String
  variant   Variant  @relation(fields: [variantId], references: [id])
  qty       Int // +receive, -sale, +/- adjust
  type      String // SALE | REFUND | RECEIVE | ADJUST | TRANSFER_IN | TRANSFER_OUT | STOCKTAKE
  reason    String?
  refId     String? // orderId / poId
  createdAt DateTime @default(now())

  @@index([outletId, variantId, createdAt])
}

// ── Customers & loyalty ───────────────────────────────────────────────────────

model Customer {
  id          String   @id @default(cuid())
  name        String
  phone       String?  @unique
  email       String?
  tin         String? // for MyInvois full e-invoice requests
  pdpaConsent Boolean  @default(false)
  points      Int      @default(0)
  storeCredit Int      @default(0) // sen
  createdAt   DateTime @default(now())

  orders Order[]
}

// ── Orders & payments ─────────────────────────────────────────────────────────

model Order {
  id                   String    @id @default(cuid())
  orderNo              String    @unique
  idempotencyKey       String    @unique
  outletId             String
  outlet               Outlet    @relation(fields: [outletId], references: [id])
  registerId           String?
  register             Register? @relation(fields: [registerId], references: [id])
  staffId              String?
  staff                User?     @relation("OrderStaff", fields: [staffId], references: [id])
  // Who authorised a discount beyond the seller's own limit. Null when the
  // sale carried no discount, or one the seller could give on their own.
  discountApprovedById String?
  discountApprovedBy   User?     @relation("OrderDiscountApprover", fields: [discountApprovedById], references: [id])
  customerId           String?
  customer             Customer? @relation(fields: [customerId], references: [id])
  // The shift that was open on this register when the sale landed. Null means
  // the sale happened outside any shift — it can never be cashed up, which is
  // exactly why the order path audits that case.
  shiftId              String?
  shift                Shift?    @relation(fields: [shiftId], references: [id])
  eventId              String?
  status               String    @default("COMPLETED") // OPEN|HELD|COMPLETED|VOIDED|REFUNDED|PARTIAL_REFUND
  subtotal             Int
  discountTotal        Int       @default(0)
  taxTotal             Int       @default(0)
  roundingAdjustment   Int       @default(0)
  total                Int
  offline              Boolean   @default(false)
  placedAt             DateTime  @default(now()) // device time
  createdAt            DateTime  @default(now()) // server time

  lines    OrderLine[]
  payments Payment[]
  einvoice EInvoice?

  @@index([outletId, createdAt])
  @@index([createdAt])
}

model OrderLine {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id])
  variantId String
  variant   Variant @relation(fields: [variantId], references: [id])
  name      String // snapshot at sale time
  sku       String
  qty       Int
  unitPrice Int
  discount  Int     @default(0)
  taxCode   String  @default("SST8")
  taxAmount Int     @default(0)
  total     Int
  notes     String?
}

model Payment {
  id          String   @id @default(cuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id])
  tender      String // TenderType
  amount      Int
  status      String   @default("CAPTURED") // PENDING|AUTHORIZED|CAPTURED|FAILED|REFUNDED|CANCELLED
  provider    String? // CASH | MOCK | FIUU | STRIPE | ADYEN ...
  providerRef String? // PSP transaction id / approval code / last4 — never PAN
  createdAt   DateTime @default(now())

  @@index([createdAt])
}

// Append-only double-entry ledger
model LedgerEntry {
  id         String   @id @default(cuid())
  txnId      String // groups the two legs
  account    String // SALES | TENDER_CASH | TENDER_DUITNOW | PSP_FEES | REFUNDS | TAX_PAYABLE ...
  debit      Int      @default(0)
  credit     Int      @default(0)
  refType    String? // ORDER | PAYMENT | REFUND | SETTLEMENT
  refId      String?
  // Where the money physically moved. Cash-up scopes on shiftId: filtering a
  // drawer by timestamp alone sweeps in every other register in every other
  // outlet that was trading in the same window. Scalars, not relations — the
  // ledger is append-only and deliberately outlives the rows it references.
  shiftId    String?
  outletId   String?
  registerId String?
  createdAt  DateTime @default(now())

  @@index([account, createdAt])
  @@index([shiftId, account])
  @@index([outletId, account, createdAt])
}

// ── Shifts & cash ─────────────────────────────────────────────────────────────

model Shift {
  id               String    @id @default(cuid())
  outletId         String
  outlet           Outlet    @relation(fields: [outletId], references: [id])
  registerId       String
  register         Register  @relation(fields: [registerId], references: [id])
  openedById       String
  openedBy         User      @relation(fields: [openedById], references: [id])
  openingFloat     Int       @default(0)
  closingCount     Int?
  expectedCash     Int?
  overShort        Int?
  openedAt         DateTime  @default(now())
  closedAt         DateTime?
  // Mirrors registerId while the shift is open, NULL once closed. The unique
  // index then enforces "one open shift per register" in the database, where a
  // check-then-insert in application code cannot: two cashiers opening the same
  // till at once both see no open shift and both create one, after which cash
  // attribution is a coin flip. Postgres does not collide NULLs, so any number
  // of closed shifts coexist.
  activeRegisterId String?   @unique

  cashMovements CashMovement[]
  orders        Order[]
}

model CashMovement {
  id        String   @id @default(cuid())
  shiftId   String
  shift     Shift    @relation(fields: [shiftId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  type      String // CASH_IN | CASH_OUT | FLOAT | DROP
  amount    Int
  reason    String?
  createdAt DateTime @default(now())
}

// ── Compliance & ops ──────────────────────────────────────────────────────────

model EInvoice {
  id          String    @id @default(cuid())
  orderId     String    @unique
  order       Order     @relation(fields: [orderId], references: [id])
  type        String    @default("CONSOLIDATED") // CONSOLIDATED | FULL
  status      String    @default("QUEUED") // QUEUED | SUBMITTED | VALIDATED | REJECTED
  uuid        String? // MyInvois document UUID
  longId      String?
  submittedAt DateTime?
  payload     Json?
}

// ── AI auto-onboarding (zero-hallucination ingest) ────────────────────────────
// User drops in an event script + item documents (barcodes/QR + pricing).
// The extractor NEVER guesses: every missing/ambiguous field becomes a
// clarification question. Catalog is only committed when zero questions remain.

model ImportSession {
  id         String   @id @default(cuid())
  name       String
  status     String   @default("EXTRACTING") // EXTRACTING | AWAITING_ANSWERS | READY | COMMITTED | FAILED
  sourceText String // raw pasted/uploaded content (event script, price list, CSV)
  eventNotes String? // extracted event context (dates, booths, expected volume)
  questions  Json? // open clarification questions [{id, itemRef, field, question}]
  answers    Json? // accumulated user answers
  createdAt  DateTime @default(now())

  items ImportItem[]
}

model ImportItem {
  id        String        @id @default(cuid())
  sessionId String
  session   ImportSession @relation(fields: [sessionId], references: [id])
  ref       String // stable reference used in questions (e.g. "item-3")
  name      String?
  sku       String?
  barcode   String?
  price     Int? // sen — null until explicitly known
  category  String?
  taxCode   String?
  qtyOnHand Int?
  evidence  String? // source-text fragment the extraction came from (auditability)
  missing   String[] // fields still unresolved — must be empty before commit
  status    String        @default("DRAFT") // DRAFT | RESOLVED | COMMITTED
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String // VOID | REFUND | PRICE_OVERRIDE | DISCOUNT | LOGIN | SHIFT_CLOSE ...
  entity    String?
  entityId  String?
  detail    Json?
  createdAt DateTime @default(now())

  @@index([action, createdAt])
}

// Hourly pre-aggregated rollups keep dashboards fast at event volume
model SalesRollupHourly {
  id       String   @id @default(cuid())
  outletId String
  bucket   DateTime // truncated to hour
  orders   Int      @default(0)
  sales    Int      @default(0)

  @@unique([outletId, bucket])
}
