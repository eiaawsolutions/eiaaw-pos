# ── API / worker ──────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/eiaaw_pos
JWT_SECRET=change-me-to-a-long-random-string
PORT=3001

# Required — the API refuses to start without it. Comma-separated for several
# origins. There is deliberately no permissive default: the previous fallback
# reflected any origin with credentials enabled.
WEB_ORIGIN=http://localhost:3000

# trace | debug | info | warn | error. Defaults to debug locally, info in
# production. Logs are JSON in production and pretty-printed otherwise.
LOG_LEVEL=

# Local Postgres/Redis ports, read by docker-compose.dev.yml. Override when
# another project on the machine already holds the defaults; DATABASE_URL and
# REDIS_URL must agree.
POSTGRES_PORT=5432
REDIS_PORT=6379

# Integration tests. Must be a separate database — the suite truncates every
# table, and refuses to run unless the name contains "test".
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/eiaaw_pos_test

# AI auto-onboarding + AI analytics (optional in dev — deterministic fallback runs without it)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# PSP (v1.0 — Fiuu/eGHL/Revenue Monster credentials go here)
#
# REQUIRED. The webhook sink is public and can mark an order paid, so this
# shared secret is the whole boundary. There is deliberately no default: the
# previous fallback meant a deployment that forgot the variable kept accepting
# webhooks signed with a value published in this repository. Missing it now
# fails the request rather than passing it.
PSP_WEBHOOK_SECRET=

# Redis (optional in scaffold; used by BullMQ queues at event scale)
REDIS_URL=

# ── Web ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001
