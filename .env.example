# ── API / worker ──────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/eiaaw_pos
JWT_SECRET=change-me-to-a-long-random-string
PORT=3001

# Required — the API refuses to start without it. Comma-separated for several
# origins. There is deliberately no permissive default: the previous fallback
# reflected any origin with credentials enabled.
WEB_ORIGIN=http://localhost:3000

# trace | debug | info | warn | error. Defaults to debug locally, info in
# production. Logs are JSON in production and pretty-printed otherwise.
LOG_LEVEL=

# Local Postgres/Redis ports, read by docker-compose.dev.yml. Override when
# another project on the machine already holds the defaults; DATABASE_URL and
# REDIS_URL must agree.
POSTGRES_PORT=5432
REDIS_PORT=6379

# Integration tests. Must be a separate database — the suite truncates every
# table, and refuses to run unless the name contains "test".
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/eiaaw_pos_test

# AI auto-onboarding + AI analytics (optional in dev — deterministic fallback runs without it)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# ─── Payments ────────────────────────────────────────────────────────────────
#
# All optional. With none of this set the POS takes cash and manually-keyed
# cards — the ones that settle at the counter and need no gateway — and refuses
# the electronic tenders with a message naming what to configure. Adding the
# keys below is the only step needed to turn those on; no code change, no
# redeploy beyond the environment.
#
# Billplz covers the whole Malaysian rail set in one contract: DuitNow QR, FPX,
# Touch 'n Go, GrabPay, Boost, ShopeePay. EIAAW already holds this account — the
# same keys are in Infisical and wired in the Social Media AI Team app — so
# there is nothing to sign up for. See EIAAW-ORG
# docs/runbooks/reuse-existing-subscriptions.md.
#
# Stripe is NOT a substitute for these rails: its Malaysian support is FPX and
# GrabPay, GrabPay is online-only, and DuitNow QR, TnG and Boost are absent
# entirely. Stripe Terminal does cover card-present in Malaysia, which is a
# separate adapter and not yet written.
BILLPLZ_API_KEY=secret://eiaaw-all-projects/prod/BILLPLZ_API_KEY
BILLPLZ_X_SIGNATURE=secret://eiaaw-all-projects/prod/BILLPLZ_X_SIGNATURE
BILLPLZ_COLLECTION_ID=
BILLPLZ_SANDBOX=true

# Where Billplz should send callbacks. Must be reachable from the internet, so
# a laptop needs a tunnel; without it bills are created but never confirmed.
PUBLIC_API_URL=

# Signing secret for the generic (mock) webhook path. Only consulted by the
# mock provider — Billplz signs with BILLPLZ_X_SIGNATURE instead. No default:
# the previous fallback meant a deployment that forgot the variable kept
# accepting webhooks signed with a value published in this repository.
PSP_WEBHOOK_SECRET=

# Fakes a QR rail that captures five seconds after the QR is shown, so the
# terminal flow can be demonstrated with no merchant account. Refuses to start
# when NODE_ENV=production — it would mark orders paid for money that never
# arrived, and the books would balance perfectly against a lie.
PAYMENTS_ENABLE_MOCK=true

# Redis (optional in scaffold; used by BullMQ queues at event scale)
REDIS_URL=

# ── Web ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001
